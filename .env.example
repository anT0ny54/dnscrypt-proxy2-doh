# Copy this file to .env for local `docker run --env-file .env` testing.
# On SnapDeploy, set these as the service's environment variables instead;
# SnapDeploy provides PORT itself, so leave that one out there.

# --- DoH gateway -------------------------------------------------------

# Public path the DoH gateway answers on.
DOH_PATH=/dns-query

# Interface the gateway binds inside the container. 0.0.0.0 so the
# platform's HTTPS front end can reach it; leave this alone on SnapDeploy.
DOH_BIND=0.0.0.0

# Local dnscrypt-proxy listener the gateway forwards to. Must match
# DNS_LISTEN below.
DOH_UPSTREAM_ADDR=127.0.0.1:5300

# Maximum accepted DoH POST body, in bytes.
DOH_MAX_BODY=65535

# Maximum DNS exchanges the gateway will run concurrently before it starts
# returning 503s. Keep this at or below dnscrypt-proxy's max_clients.
DOH_MAX_INFLIGHT=64

# Maximum simultaneously open TCP connections to the gateway.
DOH_MAX_CONNS=512

# Local port dnscrypt-proxy listens on for the gateway. Must match
# DOH_UPSTREAM_ADDR above.
DNS_LISTEN=127.0.0.1:5300

# Cosmetic only: printed in the startup log so you can copy the client
# endpoint from there. Does not affect DNS routing. Set this to the actual
# hostname SnapDeploy assigns your container after your first deploy.
PUBLIC_DOH_URL=https://dns-871de.containers.snapdeploy.app/dns-query

# --- Go runtime tuning (512MB / 0.25 vCPU budget) -----------------------

# Soft heap targets, kept separate per process -- see README "Resource
# profile". Don't reuse the same GOMEMLIMIT value for both processes.
DNSCRYPT_GOMEMLIMIT=360MiB
DOH_GOMEMLIMIT=48MiB

# --- Local Docker testing only ------------------------------------------

# SnapDeploy assigns this; only set it yourself for `docker run` testing.
# Must be an unprivileged port (>1024) since both processes run as non-root.
# PORT=8080

# Note: the KEEPALIVE_URL used by .github/workflows/snapdeploy-keepalive.yml
# is a GitHub Actions repository secret, not a container environment
# variable -- it isn't set here.
